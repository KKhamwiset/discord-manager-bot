Subject: [PATCH 6/6] chore: preserve local custom patches after upstream
 update

---
 agent/display.py      |  6 ++++
 gateway/run.py        | 23 ++++++++-----
 hermes_cli/gateway.py | 77 +++++++++++++++++++++++++++++++++++++++----
 hermes_state.py       |  6 +++-
 4 files changed, 96 insertions(+), 16 deletions(-)

diff --git a/agent/display.py b/agent/display.py
index 01267e91e..33e45a939 100644
--- a/agent/display.py
+++ b/agent/display.py
@@ -160,6 +160,12 @@ def get_tool_emoji(tool_name: str, default: str = "⚡") -> str:
     return default
 
 
+def clean_tool_name(tool_name: str) -> str:
+    """Clean tool name by replacing separators with spaces and title-casing words."""
+    cleaned = tool_name.replace('_', ' ').replace('-', ' ').replace(',', ' ')
+    return cleaned.title()
+
+
 # =========================================================================
 # Tool preview (one-line summary of a tool call's primary argument)
 # =========================================================================
diff --git a/gateway/run.py b/gateway/run.py
index 7ccb63d65..09fdb3d3b 100644
--- a/gateway/run.py
+++ b/gateway/run.py
@@ -14738,7 +14738,7 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
             last_tool[0] = tool_name
             
             # Build progress message with primary argument preview
-            from agent.display import get_tool_emoji
+            from agent.display import get_tool_emoji, clean_tool_name
             emoji = get_tool_emoji(tool_name, default="⚙️")
 
             # Markdown-capable platforms render previews as fenced code blocks.
@@ -14788,17 +14788,20 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
                     args_str = json.dumps(args, ensure_ascii=False, default=str)
                     if _pl > 0 and len(args_str) > _pl:
                         args_str = args_str[:_pl - 3] + "..."
+                    cleaned_name = clean_tool_name(tool_name)
                     if _supports_code_blocks:
-                        msg = f"{emoji} {tool_name}\n```\n{args_str}\n```"
+                        msg = f"## {emoji} {cleaned_name}\n```\n{args_str}\n```"
                     else:
-                        msg = f"{emoji} {tool_name}({list(args.keys())})\n{args_str}"
+                        msg = f"{emoji} {cleaned_name}({list(args.keys())})\n{args_str}"
                 elif preview:
+                    cleaned_name = clean_tool_name(tool_name)
                     if _supports_code_blocks:
-                        msg = f"{emoji} {tool_name}\n```\n{preview}\n```"
+                        msg = f"## {emoji} {cleaned_name}\n```\n{preview}\n```"
                     else:
-                        msg = f"{emoji} {tool_name}: \"{preview}\""
+                        msg = f"{emoji} {cleaned_name}: \"{preview}\""
                 else:
-                    msg = f"{emoji} {tool_name}..."
+                    cleaned_name = clean_tool_name(tool_name)
+                    msg = f"## {emoji} {cleaned_name}..."
                 progress_queue.put(msg)
                 return
 
@@ -14812,13 +14815,15 @@ class GatewayRunner(GatewayAuthorizationMixin, GatewayKanbanWatchersMixin, Gatew
                 _cap = _pl if _pl > 0 else (200 if _supports_code_blocks else 40)
                 if len(preview) > _cap:
                     preview = preview[:_cap - 3] + "..."
+                cleaned_name = clean_tool_name(tool_name)
                 if _supports_code_blocks:
-                    msg = f"{emoji} {tool_name}\n```\n{preview}\n```"
+                    msg = f"## {emoji} {cleaned_name}\n```\n{preview}\n```"
                 else:
-                    msg = f"{emoji} {tool_name}: \"{preview}\""
+                    msg = f"{emoji} {cleaned_name}: \"{preview}\""
                 last_was_terminal_block[0] = False
             else:
-                msg = f"{emoji} {tool_name}..."
+                cleaned_name = clean_tool_name(tool_name)
+                msg = f"## {emoji} {cleaned_name}..."
                 last_was_terminal_block[0] = False
             
             # Dedup: collapse consecutive identical progress messages.
diff --git a/hermes_cli/gateway.py b/hermes_cli/gateway.py
index 03435eac0..4b25bbd8e 100644
--- a/hermes_cli/gateway.py
+++ b/hermes_cli/gateway.py
@@ -4105,12 +4105,56 @@ def run_gateway(verbose: int = 0, quiet: bool = False, replace: bool = False, fo
         force: Skip the supervised-gateway conflict guard and start even when a
                systemd/launchd service is already supervising this profile.
     """
+    # Set console/terminal title to "DISCORD_GATEWAY"
+    try:
+        if sys.platform == "win32":
+            import ctypes
+            ctypes.windll.kernel32.SetConsoleTitleW("DISCORD_GATEWAY")  # type: ignore[attr-defined]
+        else:
+            sys.stderr.write("\033]0;DISCORD_GATEWAY\007")
+            sys.stderr.flush()
+    except Exception:
+        pass  # best-effort; don't block gateway startup
+
     _guard_official_docker_root_gateway()
     _guard_named_profile_under_multiplexer(force=force)
     _guard_supervised_gateway_conflict(force=force)
     _guard_existing_gateway_process_conflict(replace=replace)
     sys.path.insert(0, str(PROJECT_ROOT))
 
+    # Initialize skin engine for colored gateway banner
+    _skin = None
+    try:
+        from hermes_cli.skin_engine import init_skin_from_config, get_active_skin
+        from hermes_constants import get_hermes_home
+        import yaml as _yaml
+        _cfg_path = get_hermes_home() / "config.yaml"
+        if _cfg_path.exists():
+            with open(_cfg_path, encoding="utf-8") as _f:
+                _cfg = _yaml.safe_load(_f) or {}
+            init_skin_from_config(_cfg)
+            _skin = get_active_skin()
+    except Exception:
+        pass
+
+    def _hex_to_ansi(hex_color: str, bold: bool = False) -> str:
+        try:
+            r, g, b = int(hex_color[1:3], 16), int(hex_color[3:5], 16), int(hex_color[5:7], 16)
+            prefix = "1;" if bold else ""
+            return f"\033[{prefix}38;2;{r};{g};{b}m"
+        except Exception:
+            return "\033[1;33m" if bold else "\033[33m"
+
+    _RESET = "\033[0m"
+    if _skin:
+        _border_c = _hex_to_ansi(_skin.get_color("banner_border", "#FFD700"))
+        _title_c = _hex_to_ansi(_skin.get_color("banner_title", "#FFD700"), bold=True)
+        _accent_c = _hex_to_ansi(_skin.get_color("banner_accent", "#FFBF00"))
+        _dim_c = _hex_to_ansi(_skin.get_color("banner_dim", "#B8860B"))
+        _text_c = _hex_to_ansi(_skin.get_color("banner_text", "#FFF8DC"))
+    else:
+        _border_c, _title_c, _accent_c, _dim_c, _text_c = "\033[33m", "\033[1;33m", "\033[33m", "\033[2;33m", "\033[37m"
+
     # Detached Windows gateway runs must ignore console-control broadcasts
     # from sibling CLI processes, but foreground `hermes gateway run` still
     # needs to obey the banner's "Press Ctrl+C to stop" contract.
@@ -4167,12 +4211,33 @@ def run_gateway(verbose: int = 0, quiet: bool = False, replace: bool = False, fo
 
     from gateway.run import start_gateway
 
-    print("┌─────────────────────────────────────────────────────────┐")
-    print("│           ⚕ Hermes Gateway Starting...                 │")
-    print("├─────────────────────────────────────────────────────────┤")
-    print("│  Messaging platforms + cron scheduler                    │")
-    print("│  Press Ctrl+C to stop                                   │")
-    print("└─────────────────────────────────────────────────────────┘")
+    # ── Colorized gateway banner ──────────────────────────────────────
+    # Enable ANSI on Windows 10+ for true-color escape codes
+    if sys.platform == "win32":
+        try:
+            import ctypes as _ct
+            _kernel32 = _ct.windll.kernel32  # type: ignore[attr-defined]
+            _STD_OUTPUT_HANDLE = -11
+            _handle = _kernel32.GetStdHandle(_STD_OUTPUT_HANDLE)
+            _mode = _ct.c_ulong()
+            _kernel32.GetConsoleMode(_handle, _ct.byref(_mode))
+            _ENABLE_VIRTUAL_TERMINAL_PROCESSING = 0x0004
+            _kernel32.SetConsoleMode(_handle, _mode.value | _ENABLE_VIRTUAL_TERMINAL_PROCESSING)
+        except Exception:
+            pass
+
+    _b = _border_c
+    _t = _title_c
+    _a = _accent_c
+    _d = _dim_c
+    _tx = _text_c
+    _r = _RESET
+    print(f"{_b}┌─────────────────────────────────────────────────────────┐{_r}")
+    print(f"{_b}│{_r}  {_t}⚕ DISCORD_GATEWAY{_r}  {_d}— Messaging Platform Integration{_r}  {_b}│{_r}")
+    print(f"{_b}├─────────────────────────────────────────────────────────┤{_r}")
+    print(f"{_b}│{_r}  {_a}Platforms + Cron Scheduler{_r}                            {_b}│{_r}")
+    print(f"{_b}│{_r}  {_d}Press Ctrl+C to stop{_r}                                  {_b}│{_r}")
+    print(f"{_b}└─────────────────────────────────────────────────────────┘{_r}")
     print()
 
     # Exit with code 1 if gateway fails to connect any platform,
diff --git a/hermes_state.py b/hermes_state.py
index c4d072689..df43b9c02 100644
--- a/hermes_state.py
+++ b/hermes_state.py
@@ -595,6 +595,9 @@ CREATE INDEX IF NOT EXISTS idx_sessions_source ON sessions(source);
 CREATE INDEX IF NOT EXISTS idx_sessions_source_id ON sessions(source, id);
 CREATE INDEX IF NOT EXISTS idx_sessions_parent ON sessions(parent_session_id);
 CREATE INDEX IF NOT EXISTS idx_sessions_started ON sessions(started_at DESC);
+CREATE INDEX IF NOT EXISTS idx_sessions_handoff_pending
+    ON sessions(handoff_state, started_at ASC)
+    WHERE handoff_state IS NOT NULL;
 CREATE INDEX IF NOT EXISTS idx_messages_session ON messages(session_id, timestamp);
 CREATE INDEX IF NOT EXISTS idx_compression_locks_expires ON compression_locks(expires_at);
 """
@@ -4986,7 +4989,8 @@ class SessionDB:
         """
         try:
             cur = self._conn.execute(
-                "SELECT * FROM sessions "
+                "SELECT id, handoff_platform, handoff_state, handoff_error "
+                "FROM sessions "
                 "WHERE handoff_state = 'pending' "
                 "ORDER BY started_at ASC"
             )
