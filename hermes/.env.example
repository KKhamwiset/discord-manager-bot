# =============================================================================
# Hermes Agent on Railway + Remote PC Control via Tailscale & SSH
# =============================================================================
# Copy this file to .env for local testing or configure these variables in the
# Railway Dashboard under your service's "Variables" tab.
# NEVER commit real credentials, tokens, or private keys to version control!
# =============================================================================

# =============================================================================
# 1. TAILSCALE CONFIGURATION
# =============================================================================
# Auth key generated from Tailscale Admin Console (Settings -> Keys).
# Recommended: Create an ephemeral key tagged with 'tag:hermes'
TS_AUTHKEY=tskey-auth-kXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Hostname Hermes container will register as on your Tailscale network
TS_HOSTNAME=hermes-railway

# =============================================================================
# 2. REMOTE WINDOWS PC (TARGET MACHINE)
# =============================================================================
# Tailscale IP (100.x.y.z) or Tailscale MagicDNS name of your Windows PC
PC_TAILSCALE_HOST=100.x.y.z

# Windows username on the target PC (e.g., dedicated user or your Windows username)
PC_USER=hermes

# SSH port on your PC (default OpenSSH port is 22)
PC_SSH_PORT=22

# Private SSH key (Ed25519 recommended).
# Paste the entire content of ~/.ssh/id_ed25519 (including BEGIN/END headers).
# In Railway dashboard, multiline strings or single-line with literal \n are both supported.
SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# =============================================================================
# 3. HERMES TERMINAL BACKEND CONFIGURATION
# =============================================================================
# PREFERRED DESIGN (Default):
# Keep TERMINAL_ENV=local (commands run inside the Railway container by default).
# To control your Windows PC, Hermes runs: ssh mypc "<command>"
# The container's ~/.ssh/config handles routing through Tailscale userspace proxy.
TERMINAL_ENV=local

# ALTERNATIVE: Full SSH backend (All terminal commands executed on remote PC).
# If you prefer Hermes to run all terminal commands on the remote Windows PC:
# Set TERMINAL_ENV=ssh and uncomment the following:
# TERMINAL_ENV=ssh
# TERMINAL_SSH_HOST=mypc
# TERMINAL_SSH_USER=hermes
# TERMINAL_SSH_PORT=22
# TERMINAL_SSH_KEY=/root/.ssh/id_ed25519
# TERMINAL_SSH_PERSISTENT=true

# Command execution timeout in seconds (default: 60)
TERMINAL_TIMEOUT=60

# =============================================================================
# 4. LLM PROVIDER API KEYS (Configure at least one)
# =============================================================================
# OpenRouter (Access 100+ models with one key): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nous Portal (Official Nous Research platform): https://portal.nousresearch.com
NOUS_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default model (can also be selected via 'hermes model')
# e.g., openrouter/anthropic/claude-3.5-sonnet, nous/hermes-3-llama-3.1-70b
# LLM_MODEL=anthropic/claude-3.5-sonnet

# =============================================================================
# 5. MESSAGING GATEWAY: DISCORD & TELEGRAM
# =============================================================================
# Discord Bot Token from Discord Developer Portal (https://discord.com/developers/applications)
# Note: Ensure "Message Content Intent" is enabled under the Bot tab!
DISCORD_BOT_TOKEN=

# Comma-separated list of Discord user IDs allowed to interact with the bot.
# CRITICAL: Always restrict to your own user ID for security!
DISCORD_ALLOWED_USERS=123456789012345678

# Telegram Bot Token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram numeric user IDs allowed to interact with the bot.
# Obtain your ID via @userinfobot on Telegram.
TELEGRAM_ALLOWED_USERS=123456789

# Keep allowlist enforcement active (NEVER set to true in production!)
GATEWAY_ALLOW_ALL_USERS=false
